; Engine configuration file.
; REBELLIUM — MVP de movimentação.

config_version=5

[application]

config/name="REBELLIUM"
config/description="Acao acrobatica competitiva em terceira pessoa, 100% melee."
run/main_scene="res://scenes/arenas/TrainingCourse.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameEvents="*res://scripts/core/game_events.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

